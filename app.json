{
  "expo": {
    "name": "Krumplisztáni Felhőfutam: Hiperventi Kalandjai",
    "slug": "hiperventi-in-krumplisztan",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": ["ios", "android"],
    "icon": "./assets/images/icon.png",
    "scheme": "hiperventi",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.tzs007.hiperventiinkrumplisztan",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.tzs007.hiperventiinkrumplisztan"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2E8BEA",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Metamorphous",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Metamorphous/Metamorphous-Regular.ttf",
                    "weight": 400
                  }
                ]
              },
              {
                "fontFamily": "Eczar",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Eczar/app/Eczar-Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/Eczar/app/Eczar-Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/Eczar/app/Eczar-SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/Eczar/app/Eczar-Bold.ttf",
                    "weight": 700
                  },
                  {
                    "path": "./assets/fonts/Eczar/app/Eczar-ExtraBold.ttf",
                    "weight": 800
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/fonts/Metamorphous/Metamorphous-Regular.ttf",
              "./assets/fonts/Eczar/app/Eczar-Regular.ttf",
              "./assets/fonts/Eczar/app/Eczar-Medium.ttf",
              "./assets/fonts/Eczar/app/Eczar-SemiBold.ttf",
              "./assets/fonts/Eczar/app/Eczar-Bold.ttf",
              "./assets/fonts/Eczar/app/Eczar-ExtraBold.ttf"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "30e9b9ec-1898-4208-b87a-ff7d31538fbe"
      }
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/30e9b9ec-1898-4208-b87a-ff7d31538fbe"
    }
  }
}
