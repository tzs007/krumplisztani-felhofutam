# Supabase (public values — safe to ship; row level security protects the data).
# `eas integrations:supabase:connect` writes the real ones to .env.local (git-ignored)
# and to the EAS environments. For a local stack use `npx supabase status` output.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
